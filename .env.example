# Supabase — get these from your Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API — production URL on Render
EXPO_PUBLIC_API_URL=https://twinance.onrender.com

# For local development against the backend running on your machine:
# Android emulator: http://10.0.2.2:3001
# iOS simulator:    http://localhost:3001
# Physical device:  http://<your-local-ip>:3001
